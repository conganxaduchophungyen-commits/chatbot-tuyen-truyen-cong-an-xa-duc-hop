# Môi trường ứng dụng (development | production)
ENVIRONMENT=development

# Cấu hình máy chủ
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Cơ sở dữ liệu:
# SQLite (Local Dev mặc định)
DATABASE_URL=sqlite+aiosqlite:///./sql_app.db
# PostgreSQL (Production)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatbot_tuyen_truyen

# Cấu hình bảo mật JWT cho Cán bộ Quản trị
SECRET_KEY=change_this_to_a_super_secret_key_in_production_ca_xa_duc_hop
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cấu hình AI Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# Thông tin đơn vị Công an xã Đức Hợp
COMMUNE_NAME=Công an xã Đức Hợp
DISTRICT_NAME=Kim Động
PROVINCE_NAME=Hưng Yên
HOTLINE_NUMBER=0221.3811.xxx
HOTLINE_OFFICER=09xx.xxx.xxx
ADDRESS=Xã Đức Hợp, huyện Kim Động, tỉnh Hưng Yên
